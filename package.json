{
	"name": "@lukulent/svelte-umami",
	"version": "0.0.6",
	"license": "MIT",
	"keywords": [
		"svelte",
		"umami",
		"analytics",
		"web-analytics",
		"sveltekit"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/SaschaLucius/svelte-umami.git"
	},
	"author": "Sascha Lucius",
	"bugs": {
		"url": "https://github.com/SaschaLucius/svelte-umami/issues"
	},
	"scripts": {
		"dev": "vite dev",
		"buildPage": "vite build",
		"build": "vite build && npm run package",
		"preview": "vite preview",
		"package": "svelte-kit sync && svelte-package && publint",
		"prepublishOnly": "npm run package",
		"test": "npm run test:integration && npm run test:unit",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test:integration": "playwright test",
		"test:unit": "vitest run",
		"test:unit-ui": "vitest --ui",
		"test:consumer-smoke": "node scripts/consumer-smoke.mjs",
		"audit:prod": "npm audit --omit=dev"
	},
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"svelte": "./dist/index.js"
		}
	},
	"files": [
		"dist",
		"!dist/**/*.test.*",
		"!dist/**/*.spec.*",
		"!dist/images"
	],
	"peerDependencies": {
		"@sveltejs/kit": "^2.0.0",
		"svelte": "^4.0.0 || ^5.0.0"
	},
	"peerDependenciesMeta": {
		"@sveltejs/kit": {
			"optional": true
		}
	},
	"devDependencies": {
		"@eslint/js": "9.19.0",
		"@playwright/test": "^1.56.0",
		"@sveltejs/adapter-static": "^3.0.8",
		"@sveltejs/kit": "^2.70.3",
		"@sveltejs/package": "^2.3.10",
		"@sveltejs/vite-plugin-svelte": "^5.1.1",
		"@testing-library/jest-dom": "^6.6.3",
		"@testing-library/svelte": "^4.2.3",
		"@vitest/ui": "^5.0.5",
		"eslint": "^9.39.5",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.23.1",
		"globals": "15.14.0",
		"jsdom": "^24.1.3",
		"prettier": "^3.4.2",
		"prettier-plugin-svelte": "^3.3.3",
		"publint": "^0.3.2",
		"svelte": "^5.57.2",
		"svelte-check": "^4.3.1",
		"tslib": "2.8.1",
		"typescript": "5.7.3",
		"typescript-eslint": "^8.71.2",
		"vite": "^6.4.4",
		"vitest": "^5.0.5"
	},
	"svelte": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"type": "module",
	"dependencies": {
		"esm-env": "1.2.2"
	}
}
